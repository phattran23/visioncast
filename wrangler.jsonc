{
  // Cloudflare Worker: built site (dist/) + account API (worker/index.js) on D1.
  // Deploy with `npm run deploy`.
  "name": "visioncast",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visioncast",
      "database_id": "d511d459-3605-4e23-9fbb-0940b6ff4501"
    }
  ]
}
